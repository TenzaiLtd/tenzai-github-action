{
  "name": "tenzai-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Trigger a Tenzai test after a deployment workflow succeeds.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "ncc build src/main.ts --out dist --license licenses.txt --minify",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "ncc build src/action.test.ts --out .test-dist --minify && node --test .test-dist/index.js",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.44.1",
    "prettier": "3.8.1",
    "typescript": "6.0.3"
  }
}
